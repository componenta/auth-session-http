{
    "name": "componenta/auth-session-http",
    "description": "PSR-7/PSR-15 browser transport for Componenta authentication sessions",
    "type": "library",
    "license": "MIT",
    "require": {
        "componenta/auth": "^3.0",
        "componenta/auth-http": "^1.0",
        "componenta/auth-session": "^1.0",
        "componenta/http-csrf-middleware": "^3.0",
        "componenta/identity": "^1.0.1",
        "php": "^8.4",
        "psr/clock": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.4",
        "nyholm/psr7": "^1.8.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Auth\\Session\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Auth\\Session\\Http\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/componenta/auth.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/componenta/auth-http.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/componenta/auth-session.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/componenta/http-csrf-middleware.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src tests --level=max --no-progress",
        "check": [
            "@phpstan",
            "@test"
        ],
        "mutation": "@php vendor/bin/infection --threads=4 --min-msi=80 --min-covered-msi=80 --no-progress"
    }
}
